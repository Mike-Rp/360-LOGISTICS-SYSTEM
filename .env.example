# ── 360 Logistics — environment template ────────────────────────────────────
# Copy this file to .env.local and fill in the real values from
# Supabase → Project Settings → API.
#
#     cp .env.example .env.local
#
# .env.local is git-ignored. Never commit real values.
# Vite reads these at startup — restart `pnpm dev` after editing.
# Your hosting provider needs the same two variables set in its environment.

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# The anon / publishable key. This one is safe in the browser by design: what it
# is allowed to read or write is decided by the GRANTs and row-level-security
# policies in supabase/migrations, not by the key itself.
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Keep false until 20261017000000_destination_area.sql has been applied to the
# development Supabase project. Then set true in .env.local and restart pnpm dev.
VITE_DESTINATION_AREA_ENABLED=false

# Public browser token for Mapbox Geocoding v6, map previews and route previews.
# Restrict permitted origins in Mapbox before using outside localhost.
VITE_MAPBOX_ACCESS_TOKEN=<your-mapbox-public-token>

# ── Do NOT add the service_role key ─────────────────────────────────────────
# Vite exposes every variable starting with VITE_ to the browser, so putting the
# service_role key here would publish full, RLS-bypassing database access to
# anyone who opens the site. It belongs only in server-side environments.
